{
  "name": "answer-before-you-go",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.1.31",
    "esbuild": "^0.27.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "release": "bun run build && bun run zip",
    "release:win": "bun run build && bun run zip:win",
    "build": "node build.mjs --prod",
    "build:dev": "node build.mjs",
    "zip": "cd dist && zip -r ../extension.zip .",
    "zip:win": "powershell -Command \"Push-Location dist; Compress-Archive -Path * -DestinationPath ../extension.zip -Force; Pop-Location\""
  }
}
